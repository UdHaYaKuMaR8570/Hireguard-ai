# ===================================================================
# HireGuard AI — Python AI/NLP Microservice Environment Template
# ===================================================================
# Port and Host Configuration
HOST=0.0.0.0
PORT=8001

# Hugging Face Transformer Base Model Configuration
# Note: Using pretrained base model distilbert-base-uncased. Fine-tuning is scheduled for Phase 7.
MODEL_NAME=distilbert-base-uncased

# Risk Classification Thresholds (Named Constants)
# Scam Probability < LOW_RISK_THRESHOLD -> LOW
# LOW_RISK_THRESHOLD <= Scam Probability <= HIGH_RISK_THRESHOLD -> MEDIUM
# Scam Probability > HIGH_RISK_THRESHOLD -> HIGH
LOW_RISK_THRESHOLD=30
HIGH_RISK_THRESHOLD=70
